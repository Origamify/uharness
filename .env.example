# uharness config — one env file per app/context; pass env_path= to select it (default ~/.env)

# Full chat-completions endpoint URL (required)
URL=

# Bearer token (optional — omit for keyless servers)
KEY=

# Default model, used when Uharness(model=...) is not given (optional)
MODEL=

# Heavier model for detailed work (optional — falls back to MODEL)
DETAIL_MODEL=

# Quick/cheap model (optional — falls back to MODEL)
FAST_MODEL=
